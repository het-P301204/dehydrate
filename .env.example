# INVOKE Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── API Configuration ──────────────────────────────────────
API_SECRET=changeme_use_strong_secret_in_production
ENVIRONMENT=development

# ── Lab Network Configuration (Docker internal) ────────────
LAB_NETWORK=invoke_lab
CALLBACK_URL=http://callback-simulator:8080

# ── Lab Service URLs (internal Docker network) ────────────
PYTHON_LAB_URL=http://python-pickle-lab:8000
JAVA_LAB_URL=http://java-serialization-lab:8080
DOTNET_LAB_URL=http://dotnet-viewstate-lab:5000
ML_LAB_URL=http://ml-model-lab:8000

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Limits ────────────────────────────────────────────────
MAX_PAYLOAD_SIZE_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ── Lab Access Control ────────────────────────────────────
# Comma-separated CIDR ranges allowed to reach the lab API.
# Default: localhost only. Adjust for team lab environments.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Feature Flags ─────────────────────────────────────────
ENABLE_GADGET_CHAIN_LAB=true
ENABLE_ML_SCANNING=true
ENABLE_DOTNET_LAB=true
ENABLE_JAVA_LAB=true
